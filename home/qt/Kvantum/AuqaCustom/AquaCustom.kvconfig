[%General]
comment=A custom dark theme based on user palette
translucent_windows=false
blurring=false
composite=true

[GeneralColors]
# Backgrounds
window.color=#040e0d          # bg0
base.color=#0a1816            # bg1
alt.base.color=#0f211f        # bg2
button.color=#0f211f          # bg2

# Text
window.text.color=#f5e2c5     # fg
base.text.color=#f5e2c5       # fg
button.text.color=#f5e2c5     # fg
tooltip.text.color=#f5e2c5    # fg

# Primary accent (aqua)
highlight.color=#3dd1b0       # aqua
highlight.text.color=#040e0d  # bg0 (text on highlight)

# Links
link.color=#5fc8d4            # blue
visited.link.color=#e89aa8    # purple

# Disabled states
disabled.text.color=#5a4d3e   # grey1
disabled.button.text.color=#5a4d3e  # grey1

# Tooltips
tooltip.base.color=#0f211f    # bg2
