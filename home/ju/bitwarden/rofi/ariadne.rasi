* {
    /* ---- Color Variables ---- */
    bg0: #040e0d;
    bg1: #0a1816;
    bg2: #0f211f;
    bg3: #152a26;
    bg4: #1d3631;
    fg: #f5e2c5;
    red: #ff6048;
    orange: #ffa478;
    yellow: #f5cd5b;
    green: #7ad9a8;
    aqua: #3dd1b0;
    blue: #5fc8d4;
    purple: #e89aa8;
    grey0: #3a1a35;
    grey1: #5a4d3e;
    grey2: #c4b09a;

    /* ---- Global Settings ---- */
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 480px;
    background-color: @bg0;
    border: 2px;
    border-color: @bg4;
    border-radius: 8px;
}

mainbox {
    padding: 12px;
    spacing: 8px;
}

inputbar {
    background-color: @bg1;
    border-radius: 6px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
}

entry {
    placeholder: "search...";
    placeholder-color: @grey1;
}

listview {
    lines: 8;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
}

element alternate.normal {
    background-color: @bg0;
}

element selected.normal {
    background-color: @bg4;
    text-color: @bg1;
}

message {
    background-color: @bg2;
    border-radius: 6px;
    padding: 8px 12px;
}
