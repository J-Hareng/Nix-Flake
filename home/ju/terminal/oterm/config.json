{
  "splash-screen": false,
  "theme": "nord",
  "mcpServers": {
    "search": {
      "command": "/run/current-system/sw/bin/uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": {
        "HOME": "/home/ju/",
        "PATH": "/run/current-system/sw/bin:/etc/profiles/per-user/ju/bin",
        "UV_PYTHON_DOWNLOADS": "never",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-bundle.crt"
      }
    }
  }
}
